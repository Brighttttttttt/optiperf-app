# Copie ce fichier en .env.local puis remplis les valeurs
# (Supabase Dashboard → Project Settings → API)

# URL du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé publique (« anon » ou « publishable ») — utilisable côté client
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role — SECRÈTE, uniquement pour `npm run seed`, jamais exposée au client
SUPABASE_SERVICE_ROLE_KEY=
