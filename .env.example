# Copie ce fichier en .env.local puis remplis les valeurs.
# Le plus simple : bouton « Connect » du dashboard Supabase
# → onglet « App Frameworks » → Next.js.

# URL du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé publique (« publishable ») — destinée au navigateur, non secrète
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé secrète (« secret », ex-service_role) — SEULEMENT pour `npm run seed`.
# Ne jamais l'exposer au client ni la déployer sur Vercel.
SUPABASE_SECRET_KEY=

# ---- Connexion Strava (#105) ----------------------------------------------
# Identifiants de l'application, sur https://www.strava.com/settings/api
# « Authorization Callback Domain » doit valoir le domaine servi, sans schéma
# ni chemin (localhost en développement, le domaine Vercel en production).

# Public : il voyage dans l'URL d'autorisation, il n'y a rien à cacher.
NEXT_PUBLIC_STRAVA_CLIENT_ID=

# Secret. Jamais commité, jamais côté client — à poser aussi dans les
# variables d'environnement Vercel.
STRAVA_CLIENT_SECRET=

# Clé de chiffrement des jetons de fournisseurs : 32 octets en base64.
# En générer une avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ATTENTION : la changer invalide toutes les connexions existantes — les
# athlètes devront se reconnecter.
PROVIDER_TOKEN_KEY=
